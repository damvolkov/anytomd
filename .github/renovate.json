{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "enabledManagers": [
    "cargo",
    "custom.regex",
    "github-actions",
    "pep621"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "Europe/Madrid",
  "prConcurrentLimit": 3,
  "abandonmentThreshold": "1 year",
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on the first day of the month"
    ],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "requires-python is a support promise, not a dependency: never bumped by a bot.",
      "matchDepTypes": [
        "requires-python"
      ],
      "enabled": false
    },
    {
      "description": "The engine: react at once, one PR per release, changelog and licenses by sync.yml, gaps filled by maintenance.yml.",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "anytomd"
      ],
      "schedule": [
        "at any time"
      ],
      "labels": [
        "upstream-update"
      ],
      "commitMessagePrefix": "upstream:",
      "automerge": false
    },
    {
      "description": "PyO3 and tokio shape the binding itself: separate PRs, maintenance repairs breakage.",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "pyo3",
        "tokio"
      ],
      "labels": [
        "binding-update"
      ],
      "automerge": false
    },
    {
      "description": "Python tooling (dependency groups and the build backend): one weekly PR, merges itself on green.",
      "matchManagers": [
        "pep621"
      ],
      "groupName": "python tooling",
      "labels": [
        "tooling"
      ],
      "matchDepTypes": [
        "dependency-groups",
        "build-system.requires"
      ],
      "automerge": true
    },
    {
      "description": "Workflow actions stay pinned by digest; one monthly PR.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "pinDigests": true,
      "schedule": [
        "before 6am on the first day of the month"
      ],
      "labels": [
        "tooling"
      ],
      "automerge": true
    },
    {
      "description": "Runtime deps of a library: widen the range, never raise the floor users resolve against; patches merge themselves.",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "project.dependencies"
      ],
      "rangeStrategy": "widen",
      "labels": [
        "runtime"
      ]
    },
    {
      "description": "Runtime patch releases merge themselves once every required check passes.",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "project.dependencies"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "The agent's CLI pin: tooling, merges itself once every required check passes.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "@qwen-code/qwen-code"
      ],
      "labels": [
        "tooling"
      ],
      "automerge": true
    }
  ],
  "platformAutomerge": true,
  "automergeType": "pr",
  "customManagers": [
    {
      "description": "The agent's CLI pin, the default of QWEN_CLI_VERSION in the maintenance workflow.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/maintenance\\.yml$/"
      ],
      "matchStrings": [
        "QWEN_CLI_VERSION \\|\\| '(?<currentValue>\\d+\\.\\d+\\.\\d+)'"
      ],
      "depNameTemplate": "@qwen-code/qwen-code",
      "datasourceTemplate": "npm"
    }
  ]
}
